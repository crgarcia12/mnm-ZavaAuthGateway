<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="ZavaBankDb" connectionString="Server=sqlserver,1433;Database=ZavaBankDB;User Id=sa;Password=Zava123!;TrustServerCertificate=true;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <customErrors mode="Off" />
    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx" timeout="30" name=".ZAVAAUTH" protection="All" slidingExpiration="true" path="/" />
    </authentication>
    <machineKey validationKey="CB2721ABDAF8E9DC516D621D8B8BF13A2C9E8689A25303BF" decryptionKey="E9D2490BD0075B51D1BA5288514514AF" validation="SHA1" decryption="AES" />
    <authorization>
      <deny users="?" />
    </authorization>
    <httpHandlers>
      <add verb="GET" path="api/auth/validate" type="ZavaAuthGateway.ApiAuthValidateHandler" />
      <add verb="GET" path="health" type="ZavaAuthGateway.HealthHandler" />
    </httpHandlers>
  </system.web>
  <location path="Login.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Default.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Logout.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="api/auth/validate">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="health">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="WhoAmI.ashx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <system.webServer>
    <handlers>
      <add name="ApiAuthValidateHandler" path="api/auth/validate" verb="GET" type="ZavaAuthGateway.ApiAuthValidateHandler" resourceType="Unspecified" />
      <add name="HealthHandler" path="health" verb="GET" type="ZavaAuthGateway.HealthHandler" resourceType="Unspecified" />
    </handlers>
  </system.webServer>
</configuration>
